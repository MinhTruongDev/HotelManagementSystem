<Window x:Class="HotelManagementSystem.Views.Dialogs.ReservationEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Reservation"
        Width="480"
        SizeToContent="Height"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F7FA">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Create reservation"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Guest name" Margin="0,0,0,6"/>
            <TextBox Text="{Binding GuestName, UpdateSourceTrigger=PropertyChanged}"
                     Padding="9"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Check-in" Margin="0,0,0,6"/>
                <DatePicker SelectedDate="{Binding CheckInDate}"
                            Padding="5"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Check-out" Margin="0,0,0,6"/>
                <DatePicker SelectedDate="{Binding CheckOutDate}"
                            Padding="5"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="Number of guests" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding GuestCountOptions}"
                      SelectedItem="{Binding GuestCount}"
                      Padding="8"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,14">
            <TextBlock Text="Available room" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding AvailableRooms}"
                      SelectedItem="{Binding SelectedRoom}"
                      Padding="8">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Number}"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding Type}"/>
                            <Run Text=" (capacity "/>
                            <Run Text="{Binding Capacity}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="5"
                   Text="{Binding ValidationMessage}"
                   Foreground="#B42318"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    MinWidth="90"
                    Padding="12,8"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Command="{Binding CancelCommand}"/>

            <Button Content="Create reservation"
                    MinWidth="150"
                    Padding="12,8"
                    IsDefault="True"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
