<UserControl x:Class="HotelManagementSystem.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PageBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page heading -->
        <TextBlock Grid.Row="0"
                   Text="Good morning, Jordan"
                   Style="{StaticResource PageTitle}"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="Here is what is happening at StayWise today."
                   Foreground="{StaticResource MutedBrush}"
                   Margin="0,0,0,25"/>

        <!-- Summary cards -->
        <UniformGrid Grid.Row="2"
                     Columns="4"
                     Margin="0,0,0,24">

            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="TODAY'S CHECK-INS"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               FontWeight="Bold"/>
                    <TextBlock Text="18"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,8,0,3"/>
                    <TextBlock Text="On schedule"
                               Foreground="#2F8F68"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="TODAY'S CHECK-OUTS"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               FontWeight="Bold"/>
                    <TextBlock Text="11"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,8,0,3"/>
                    <TextBlock Text="On schedule"
                               Foreground="#2F8F68"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="OCCUPIED ROOMS"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               FontWeight="Bold"/>
                    <TextBlock Text="74 / 96"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,8,0,3"/>
                    <TextBlock Text="77% occupancy"
                               Foreground="#D48A32"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="UPCOMING RESERVATIONS"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               FontWeight="Bold"/>
                    <TextBlock Text="42"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,8,0,3"/>
                    <TextBlock Text="Next 7 days"
                               Foreground="#4F8CC9"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Quick actions -->
        <Border Grid.Row="3"
                Style="{StaticResource Card}"
                Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Quick actions"
                           Style="{StaticResource SectionTitle}"
                           Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="New reservation"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewBookingCommand}"
                            Margin="0,0,12,0"/>

                    <Button Content="Manage rooms"
                            Style="{StaticResource QuietButton}"
                            Command="{Binding ManageRoomCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Today's arrivals -->
        <Border Grid.Row="4"
                Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Today's arrivals"
                           Style="{StaticResource SectionTitle}"
                           Margin="0,0,0,16"/>

                <TextBlock Text="Amelia Rodriguez     Room 401     14:30"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Marcus Chen            Room 502     16:00"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>