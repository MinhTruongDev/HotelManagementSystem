<UserControl x:Class="HotelManagementSystem.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HotelManagementSystem.ViewModels"
             xmlns:pagevm="clr-namespace:HotelManagementSystem.ViewModels.Pages"
             xmlns:views="clr-namespace:HotelManagementSystem.Views.Pages"
             Background="{DynamicResource PageBrush}">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type pagevm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type pagevm:BookingsViewModel}">
            <views:BookingsView />
        </DataTemplate>

        <!--<DataTemplate DataType="{x:Type pagevm:RoomsViewModel}">
            <views:RoomsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type pagevm:EmployeesViewModel}">
            <views:EmployeesView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type pagevm:AccountsViewModel}">
            <views:AccountsView />
        </DataTemplate>-->

        <DataTemplate DataType="{x:Type pagevm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="ShellPanel">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">

            <Grid>
                <Button x:Name="MenuButton"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource NavyBrush}"
                        Background="Transparent"
                        Width="62"
                        Height="60"
                        Padding="0"
                        ToolTip="Toggle navigation menu">

                    <StackPanel Width="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Height="2"
                                Background="{StaticResource NavyBrush}"
                                Margin="0,3" />
                        <Border Height="2"
                                Background="{StaticResource NavyBrush}"
                                Margin="0,3" />
                        <Border Height="2"
                                Background="{StaticResource NavyBrush}"
                                Margin="0,3" />
                    </StackPanel>
                </Button>

                <TextBlock Text="{Binding CurrentBreadcrumb}"
                           Margin="78,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,28,0">

                    <Border Width="36"
                            Height="36"
                            Background="#E9EEF7"
                            CornerRadius="18">
                        <TextBlock Text="JS"
                                   Foreground="{StaticResource NavyBrush}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Jordan Smith"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Front Desk Manager"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn"
                                  Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="SidebarBorder"
                    Grid.Column="0"
                    Background="{StaticResource SidebarBrush}">

                <DockPanel>
                    <StackPanel DockPanel.Dock="Top"
                                Margin="0,25,0,20">
                        <TextBlock Text="STAYWISE"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="HOTEL OPERATIONS"
                                   Foreground="#8190A9"
                                   FontSize="9"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0" />
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom"
                            Content="Sign out"
                            Foreground="#F3F6FC"
                            Tag="Logout"
                            Style="{StaticResource NavButton}"
                            IsEnabled="False"
                            ToolTip="Sign-out workflow has not been implemented yet"
                            Margin="8,0,8,20" />

                    <StackPanel>
                        <Button Content="Dashboard"
                                Foreground="#F3F6FC"
                                Tag="Dashboard"
                                Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:PageKey.Dashboard}" />

                        <Button Content="Bookings &amp; Reservations"
                                Foreground="#F3F6FC"
                                Tag="Bookings"
                                Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:PageKey.Bookings}" />

                        <!--<Button Content="Rooms"
                                Foreground="#F3F6FC"
                                Tag="Rooms"
                                Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:PageKey.Rooms}" />

                        <Button Content="Employee Management"
                                Foreground="#F3F6FC"
                                Tag="Employees"
                                Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:PageKey.Employees}" />

                        <Button Content="Account Management"
                                Foreground="#F3F6FC"
                                Tag="Accounts"
                                Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:PageKey.Accounts}" />-->

                        <Button Content="Settings"
                                Foreground="#F3F6FC"
                                Tag="Settings"
                                Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:PageKey.Settings}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Selected page -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding CurrentPage}"
                                Margin="34" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
