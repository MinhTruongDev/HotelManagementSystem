<Window x:Class="HotelManagementSystem.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="StayWise Hotel Management" Width="1440" Height="900" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}">
    <Window.Resources>
        <DataTemplate x:Key="BookingRow">
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Reference}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Guest}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Room}"/>
                    <TextBlock Grid.Column="3" Text="{Binding CheckIn}"/>
                    <TextBlock Grid.Column="4" Text="{Binding CheckOut}"/>
                    <TextBlock Grid.Column="5" Text="{Binding Guests}"/>
                    <TextBlock Grid.Column="6" Text="{Binding Status}" Foreground="#2F8F68" FontWeight="SemiBold"/>
                    <Button Grid.Column="7" Content="View details" Foreground="#4F8CC9" Background="Transparent" Padding="0" HorizontalContentAlignment="Left" Click="ReservationDetails_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="RoomTypeGroupTemplate">
            <StackPanel Margin="0,0,0,18">
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitle}" Margin="0"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Rooms}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}" Click="RoomSelection_Click" Style="{StaticResource QuietButton}" Width="190" Height="92" Margin="0,0,12,12" HorizontalContentAlignment="Left">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="{Binding Number}" FontSize="18" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#2F8F68" FontSize="11" FontWeight="SemiBold"/></DockPanel>
                                    <TextBlock Text="{Binding Type}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding Capacity, StringFormat='Capacity: {0}'}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="LoginPanel" Background="{StaticResource NavyBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="85" VerticalAlignment="Center">
                <TextBlock Text="STAYWISE" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Thoughtful stays.&#10;Seamless operations." Foreground="White" FontSize="42" FontWeight="SemiBold" Margin="0,25,0,18"/>
                <TextBlock Text="A calm, clear workspace for every moment behind the front desk." Foreground="#B9C4D8" FontSize="16" Width="390" TextWrapping="Wrap"/>
                <Border Height="1" Background="#41516D" Width="390" HorizontalAlignment="Left" Margin="0,42,0,22"/>
                <TextBlock Text="HOTEL OPERATIONS PLATFORM  /  2026" Foreground="#8190A9" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
                    <Grid Grid.Column="1" Background="{DynamicResource PageBrush}">
                        <Border Width="410" Padding="38" Background="{StaticResource CardBrush}" CornerRadius="12" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Welcome back" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Sign in to your hotel workspace" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,30"/>
                        <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBox x:Name="UsernameBox" Style="{StaticResource Field}" Text="reception@staywise.com"/>
                        <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,20,0,7"/>
                        <Grid>
                            <PasswordBox x:Name="PasswordBox" Padding="11,9" BorderBrush="{StaticResource LineBrush}"/>
                            <TextBox x:Name="PasswordTextBox" Style="{StaticResource Field}" Visibility="Collapsed"/>
                        </Grid>
                        <DockPanel Margin="0,14,0,25">
                            <CheckBox Content="Remember me" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock DockPanel.Dock="Right" Text="Forgot password?" Foreground="#4F8CC9"/>
                        </DockPanel>
                        <Button Content="Sign in to workspace" Style="{StaticResource PrimaryButton}" Height="44" Click="SignIn_Click"/>
                        <TextBlock x:Name="LoginMessage" TextAlignment="Center" Foreground="#C85252" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Grid x:Name="ShellPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Button x:Name="MenuButton" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource NavyBrush}" Background="Transparent" Width="62" Height="60" Padding="0" Click="MenuButton_Click" ToolTip="Toggle navigation menu">
                        <StackPanel Width="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Height="2" Background="{StaticResource NavyBrush}" Margin="0,3"/>
                            <Border Height="2" Background="{StaticResource NavyBrush}" Margin="0,3"/>
                            <Border Height="2" Background="{StaticResource NavyBrush}" Margin="0,3"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="Breadcrumb" Text="Overview  /  Dashboard" Margin="78,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0">
                        <Border Width="36" Height="36" Background="#E9EEF7" CornerRadius="18">
                            <TextBlock Text="JS" Foreground="{StaticResource NavyBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Jordan Smith" FontWeight="SemiBold"/>
                            <TextBlock Text="Front Desk Manager" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="SidebarBorder" Grid.Column="0" Background="{StaticResource SidebarBrush}">
                    <Border.RenderTransform>
                        <TranslateTransform X="-230"/>
                    </Border.RenderTransform>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,25,0,20">
                            <TextBlock Text="STAYWISE" Foreground="{StaticResource AccentBrush}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="HOTEL OPERATIONS" Foreground="#8190A9" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <Button Content="Dashboard" Foreground="#F3F6FC" Tag="Dashboard" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                            <Button Content="Bookings &amp; Reservations" Foreground="#F3F6FC" Tag="Bookings" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                            <Button Content="Rooms" Foreground="#F3F6FC" Tag="Rooms" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                            <Button Content="Employee Management" Foreground="#F3F6FC" Tag="Employees" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                            <Button Content="Account Management" Foreground="#F3F6FC" Tag="Accounts" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                            <Button Content="Settings" Foreground="#F3F6FC" Tag="Settings" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom" Content="Sign out" Foreground="#F3F6FC" Tag="Logout" Style="{StaticResource NavButton}" Click="Nav_Click" Margin="8,0,8,20"/>
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="34">
                        <Grid x:Name="ContentPages">
                            <StackPanel x:Name="DashboardPage">
                                <TextBlock Text="Good morning, Jordan" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Here is what is happening at StayWise today." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,25"/>
                                <UniformGrid Columns="4">
                                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TODAY'S CHECK-INS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="18" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock Text="On schedule" Foreground="#2F8F68"/></StackPanel></Border>
                                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TODAY'S CHECK-OUTS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="11" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock Text="On schedule" Foreground="#2F8F68"/></StackPanel></Border>
                                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="OCCUPIED ROOMS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="74 / 96" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock Text="77% occupancy" Foreground="#D48A32"/></StackPanel></Border>
                                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="UPCOMING RESERVATIONS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="42" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock Text="Next 7 days" Foreground="#4F8CC9"/></StackPanel></Border>
                                </UniformGrid>
                                <Border Style="{StaticResource Card}" Margin="0,0,16,16"><StackPanel><TextBlock Text="Quick actions" Style="{StaticResource SectionTitle}"/><StackPanel Orientation="Horizontal"><Button Content="New reservation" Style="{StaticResource PrimaryButton}" Click="NewBooking_Click" Margin="0,0,12,0"/><Button Content="Manage rooms" Style="{StaticResource QuietButton}" Click="RoomsShortcut_Click"/></StackPanel></StackPanel></Border>
                                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Today's arrivals" Style="{StaticResource SectionTitle}"/><TextBlock Text="Amelia Rodriguez     Room 401     14:30" Margin="0,0,0,12"/><TextBlock Text="Marcus Chen            Room 502     16:00"/></StackPanel></Border>
                            </StackPanel>
                            <StackPanel x:Name="BookingsPage" Visibility="Collapsed">
                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="Bookings &amp; Reservations" Style="{StaticResource PageTitle}"/>
                                        <TextBlock Text="Search and manage guest stays." Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Cycle demo status" Style="{StaticResource QuietButton}" Click="ReservationStatus_Click" Margin="0,0,10,0"/>
                                        <Button Content="+  New reservation" Style="{StaticResource PrimaryButton}" Click="NewBooking_Click"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Card}" Margin="0,25,0,0">
                                    <DockPanel>
                                        <TextBox x:Name="ReservationSearchBox" Width="270" Style="{StaticResource Field}" TextChanged="ReservationSearch_TextChanged"/>
                                        <ComboBox Width="145" Margin="12,0,0,0" Padding="9" SelectedIndex="0">
                                            <ComboBoxItem>All statuses</ComboBoxItem>
                                            <ComboBoxItem>Confirmed</ComboBoxItem>
                                            <ComboBoxItem>Pending</ComboBoxItem>
                                            <ComboBoxItem>Cancelled</ComboBoxItem>
                                        </ComboBox>
                                        <DatePicker Width="145" Margin="12,0,0,0"/>
                                        <Button DockPanel.Dock="Right" Content="Export list" Style="{StaticResource QuietButton}"/>
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="Select a room by type" Style="{StaticResource SectionTitle}" Margin="0,8,0,12"/>
                                <ItemsControl ItemsSource="{Binding RoomGroups}" ItemTemplate="{StaticResource RoomTypeGroupTemplate}"/>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="0" Margin="0,0,16,16">
                                    <StackPanel>
                                        <Border Background="#F8F9FB" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="95"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="REFERENCE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock Grid.Column="1" Text="GUEST" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock Grid.Column="2" Text="ROOM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock Grid.Column="3" Text="CHECK-IN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock Grid.Column="4" Text="CHECK-OUT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock Grid.Column="5" Text="GUESTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock Grid.Column="6" Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock Grid.Column="7" Text="ACTIONS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl x:Name="ReservationGrid" ItemsSource="{Binding AllBookings}" ItemTemplate="{StaticResource BookingRow}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="RoomsPage" Visibility="Collapsed">
                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="Room management" Style="{StaticResource PageTitle}"/>
                                        <TextBlock Text="Monitor room inventory and operational status." Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="+  Add floor" Style="{StaticResource QuietButton}" Click="AddFloor_Click" Margin="0,0,10,0"/>
                                        <Button Content="Edit floor" Style="{StaticResource QuietButton}" Click="EditFloor_Click" Margin="0,0,10,0"/>
                                        <Button Content="Edit room" Style="{StaticResource QuietButton}" Click="EditSelectedRoom_Click" Margin="0,0,10,0"/>
                                        <Button Content="Deactivate room" Style="{StaticResource QuietButton}" Click="DeactivateRoom_Click" Margin="0,0,10,0"/>
                                        <Button Content="+  Add room" Style="{StaticResource PrimaryButton}" Click="AddRoom_Click"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Card}" Margin="0,25,0,0">
                                    <DockPanel>
                                        <TextBox x:Name="RoomSearchBox" Width="280" Style="{StaticResource Field}" TextChanged="RoomSearch_TextChanged"/>
                                        <ComboBox Width="150" Margin="12,0,0,0" Padding="9" SelectedIndex="0">
                                            <ComboBoxItem>All room types</ComboBoxItem>
                                            <ComboBoxItem>Standard</ComboBoxItem>
                                            <ComboBoxItem>Deluxe</ComboBoxItem>
                                            <ComboBoxItem>Suite</ComboBoxItem>
                                        </ComboBox>
                                        <ComboBox Width="150" Margin="12,0,0,0" Padding="9" SelectedIndex="0">
                                            <ComboBoxItem>All statuses</ComboBoxItem>
                                            <ComboBoxItem>Available</ComboBoxItem>
                                            <ComboBoxItem>Occupied</ComboBoxItem>
                                            <ComboBoxItem>Maintenance</ComboBoxItem>
                                        </ComboBox>
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="Room inventory" Style="{StaticResource SectionTitle}" Margin="0,4,0,8"/>
                                <DataGrid x:Name="RoomGrid" ItemsSource="{Binding Rooms}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ROOM" Binding="{Binding Number}" Width="90"/>
                                        <DataGridTextColumn Header="FLOOR" Binding="{Binding Floor}" Width="80"/>
                                        <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="*"/>
                                        <DataGridTextColumn Header="CAPACITY" Binding="{Binding Capacity}" Width="100"/>
                                        <DataGridTextColumn Header="PRICE / NIGHT" Binding="{Binding Price, StringFormat=C}" Width="125"/>
                                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid></StackPanel>
                            <StackPanel x:Name="EmployeesPage" Visibility="Collapsed">
                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="Employee management" Style="{StaticResource PageTitle}"/>
                                        <TextBlock Text="Keep your front-of-house team organized." Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Edit selected" Style="{StaticResource QuietButton}" Click="EditEmployee_Click" Margin="0,0,10,0"/>
                                        <Button Content="Deactivate" Style="{StaticResource QuietButton}" Click="DeactivateEmployee_Click" Margin="0,0,10,0"/>
                                        <Button Content="+  Add employee" Style="{StaticResource PrimaryButton}" Click="AddEmployee_Click"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Card}" Margin="0,25,0,0">
                                    <DockPanel>
                                        <TextBox x:Name="EmployeeSearchBox" Width="300" Style="{StaticResource Field}" TextChanged="EmployeeSearch_TextChanged"/>
                                        <ComboBox Width="170" Margin="12,0,0,0" Padding="9" SelectedIndex="0">
                                            <ComboBoxItem>All positions</ComboBoxItem>
                                            <ComboBoxItem>Receptionist</ComboBoxItem>
                                            <ComboBoxItem>Housekeeping</ComboBoxItem>
                                            <ComboBoxItem>Manager</ComboBoxItem>
                                        </ComboBox>
                                    </DockPanel>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="20">
                                    <StackPanel>
                                        <DataGrid x:Name="EmployeeGrid" ItemsSource="{Binding Employees}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="EMPLOYEE ID" Binding="{Binding Id}" Width="110"/>
                                                <DataGridTextColumn Header="FULL NAME" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="120"/>
                                                <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="1.3*"/>
                                                <DataGridTextColumn Header="POSITION" Binding="{Binding Position}" Width="130"/>
                                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="AccountsPage" Visibility="Collapsed">
                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="Account management" Style="{StaticResource PageTitle}"/>
                                        <TextBlock Text="Manage workspace access for hotel staff." Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Deactivate demo" Style="{StaticResource QuietButton}" Click="DeactivateAccount_Click" Margin="0,0,10,0"/>
                                        <Button Content="Edit selected" Style="{StaticResource QuietButton}" Click="EditAccount_Click" Margin="0,0,10,0"/>
                                        <Button Content="+  Create account" Style="{StaticResource PrimaryButton}" Click="CreateAccount_Click"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="20" Margin="0,25,16,16">
                                    <StackPanel>
                                        <DataGrid x:Name="AccountGrid" ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ACCOUNT ID" Binding="{Binding Id}" Width="100"/><DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="1.3*"/>
                                                <DataGridTextColumn Header="EMPLOYEE" Binding="{Binding Employee}" Width="1.5*"/>
                                                <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="1.1*"/>
                                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
                                <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Personalize your StayWise workspace." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,25"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="User profile" Style="{StaticResource SectionTitle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="300"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Display name" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="Jordan Smith"/>
                                        </Grid>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="300"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Email address" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="jordan.smith@staywise.com"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Application preferences" Style="{StaticResource SectionTitle}"/>
                                        <CheckBox Content="Show arrival reminders on the dashboard" IsChecked="True" Margin="0,0,0,15"/>
                                        <CheckBox Content="Play a sound for new reservations" Margin="0,0,0,15"/>
                                        <CheckBox Content="Use compact table density"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" Margin="0,8,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <Button Content="Light mode" Style="{StaticResource QuietButton}" Click="ThemeLight_Click" Margin="0,0,10,0"/>
                                    <Button Content="Dark mode" Style="{StaticResource QuietButton}" Click="ThemeDark_Click"/>
                                </StackPanel>
                                <Button Content="Save preferences" Style="{StaticResource PrimaryButton}" Width="145" HorizontalAlignment="Left" Click="MockDialog_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>











